# Prathyusha Engineering College - Digital Leave Permission Portal Environment Configuration

# Database Configuration (PostgreSQL Connection String for Render / Local)
DATABASE_URL="postgresql://pec_user:password@localhost:5432/pec_db?schema=public"

# Security & Authentication Secrets (Generate 64-character random strings in production)
JWT_SECRET="your_production_jwt_secret_key_here"
JWT_REFRESH_SECRET="your_production_jwt_refresh_secret_key_here"

# Server Ports & Node Environment
PORT=5000
NODE_ENV="production"

# CORS Allowed Origin (Deployed Frontend URL)
FRONTEND_URL="https://pec-leave-portal-frontend.onrender.com"
ALLOWED_ORIGINS="https://pec-leave-portal-frontend.onrender.com"

# Frontend Client Environment Variables
VITE_API_URL="https://pec-leave-portal-backend.onrender.com/api"
VITE_SOCKET_URL="https://pec-leave-portal-backend.onrender.com"

# Optional SMTP Email Configuration
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="notifications@prathyusha.edu.in"
SMTP_PASSWORD="your_app_password_here"
SMTP_FROM="PEC Leave Portal <notifications@prathyusha.edu.in>"
